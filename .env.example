# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL="file:data/app.db"

# ============================================
# AUTHENTICATION
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # Generate with: openssl rand -base64 32
JWT_SECRET="" # Generate with: openssl rand -base64 32
JWT_EXPIRATION_HOURS=24

# Admin Account (First Run)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123" # Change this!
ADMIN_ID="admin"

# ============================================
# RAG & EMBEDDINGS CONFIGURATION
# ============================================

# Embedding Provider (openai or gemini)
EMBEDDING_PROVIDER="gemini"

# Gemini Configuration (PRIMARY)
GEMINI_API_KEY="" # Get from: https://makersuite.google.com/app/apikey

# OpenAI Configuration (OPTIONAL - Fallback)
OPENAI_API_KEY="" # Get from: https://platform.openai.com/api-keys

# CustomGPT Configuration (OPTIONAL)
CUSTOMGPT_API_KEY=""
CUSTOMGPT_API_BASE_URL="https://app.customgpt.ai/api/v1"
CUSTOMGPT_BASE_URL="http://localhost:3000"

# ============================================
# QDRANT VECTOR DATABASE
# ============================================
QDRANT_URL="http://localhost:6333"
QDRANT_TIMEOUT=30000

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV="development"
PORT=3000

# Logging
LOG_LEVEL="info"
LOG_FILE="logs/app.log"

# Backup Settings
BACKUP_DIR="backups"
BACKUP_RETENTION_DAYS=30

# ============================================
# SECURITY
# ============================================
SESSION_MAX_AGE=86400 # 24 hours in seconds
BCRYPT_SALT_ROUNDS=12
ALLOWED_ORIGINS="*" # For production: comma-separated domains

# Rate Limiting
RATE_LIMIT_WINDOW=900000 # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# RAG COLLECTION SETTINGS
# ============================================
DEFAULT_SEMANTIC_THRESHOLD=0.7
DEFAULT_MAX_CHUNKS=5
DEFAULT_SEARCH_STRATEGY="semantic" # Options: semantic, hybrid, keyword

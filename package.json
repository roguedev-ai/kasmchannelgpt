{
  "name": "kasmchannelgpt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:setup": "tsx scripts/setup-database.ts",
    "create:admin": "node scripts/create-admin.js",
    "migrate": "node --loader ts-node/esm scripts/migrate-collections.ts",
    "logs": "tail -f logs/app.log",
    "health-check": "curl -f http://localhost:3000/api/health || exit 1",
    "backup": "mkdir -p backups && cp data/app.db \"backups/app.db.$(date +%Y%m%d_%H%M%S)\"",
    "restore": "bash -c 'if [ -z \"$1\" ]; then echo \"Usage: npm run restore <backup-file>\"; exit 1; fi; cp \"$1\" data/app.db'",
    "list-backups": "ls -l backups/",
    "clean": "rm -rf .next out",
    "deploy": "npm run build && npm run migrate && npm start"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@auth/core": "^0.18.0",
    "@google/generative-ai": "^0.1.3",
    "@headlessui/react": "^1.7.17",
    "@langchain/core": "^0.1.0",
    "@langchain/openai": "^0.0.19",
    "@langchain/textsplitters": "^0.0.1",
    "@qdrant/js-client-rest": "^1.9.0",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@tanstack/react-query": "^4.35.3",
    "@tanstack/react-table": "^8.10.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^8.7.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dompurify": "^3.0.6",
    "drizzle-orm": "^0.28.6",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.1.0",
    "lucide-react": "^0.294.0",
    "mammoth": "^1.6.0",
    "nanoid": "^3.3.6",
    "next": "^13.5.6",
    "next-auth": "^4.24.5",
    "openai": "^4.20.0",
    "pdf-parse": "^1.1.1",
    "posthog-node": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-is": "^18.2.0",
    "react-syntax-highlighter": "^15.5.0",
    "recharts": "^2.10.3",
    "sonner": "^1.2.0",
    "tailwind-merge": "^2.1.0",
    "undici": "5.28.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/dompurify": "^3.0.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-syntax-highlighter": "^15.5.11",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-config-next": "^13.5.6",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}

# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# For deployment server: 146.235.215.36
# Domain: kasmpartners.workoverip.app
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL="file:/app/data/app.db"

# ============================================
# AUTHENTICATION
# ============================================
NEXTAUTH_URL="https://kasmpartners.workoverip.app"
NEXTAUTH_SECRET="" # REQUIRED: openssl rand -base64 32
JWT_SECRET="" # REQUIRED: openssl rand -base64 32
JWT_EXPIRATION_HOURS=24

# Admin Account (First Run)
ADMIN_EMAIL="admin@kasmpartners.workoverip.app"
ADMIN_PASSWORD="" # REQUIRED: Set strong password
ADMIN_ID="admin"

# ============================================
# RAG & EMBEDDINGS CONFIGURATION
# ============================================

# Embedding Provider (gemini recommended for production)
EMBEDDING_PROVIDER="gemini"

# Gemini Configuration (PRIMARY)
GEMINI_API_KEY="" # REQUIRED: Get from https://makersuite.google.com/app/apikey

# OpenAI Configuration (OPTIONAL - Fallback)
OPENAI_API_KEY=""

# CustomGPT Configuration (OPTIONAL)
CUSTOMGPT_API_KEY=""
CUSTOMGPT_API_BASE_URL="https://app.customgpt.ai/api/v1"
CUSTOMGPT_BASE_URL="https://kasmpartners.workoverip.app"

# ============================================
# QDRANT VECTOR DATABASE
# ============================================
# Docker Compose service name
QDRANT_URL="http://qdrant:6333"
QDRANT_TIMEOUT=30000

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

# Logging
LOG_LEVEL="info"
LOG_FILE="/app/logs/app.log"

# Backup Settings
BACKUP_DIR="/app/backups"
BACKUP_RETENTION_DAYS=30

# ============================================
# SECURITY
# ============================================
SESSION_MAX_AGE=86400 # 24 hours in seconds
BCRYPT_SALT_ROUNDS=12
ALLOWED_ORIGINS="https://kasmpartners.workoverip.app"

# Rate Limiting
RATE_LIMIT_WINDOW=900000 # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# RAG COLLECTION SETTINGS
# ============================================
DEFAULT_SEMANTIC_THRESHOLD=0.7
DEFAULT_MAX_CHUNKS=5
DEFAULT_SEARCH_STRATEGY="semantic" # Options: semantic, hybrid, keyword

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 1. Copy this file to .env.production on the server
# 2. Fill in all REQUIRED fields
# 3. Generate secrets: openssl rand -base64 32
# 4. Keep this file secure - never commit to Git!
